# PostgreSQL connection string. Replace YOUR_POSTGRES_PASSWORD with your local postgres role password.
DATABASE_URL=postgresql://postgres:YOUR_POSTGRES_PASSWORD@127.0.0.1:5432/cybershield

# Required in production. Use a long random value (at least 32 bytes recommended).
JWT_SECRET=replace-with-a-long-random-production-secret

# Optional: defaults to development when unset.
NODE_ENV=development
